# ==============================================================================
# SENTINEL GRID — Production Environment Configuration
# ==============================================================================

# Database Configuration (PostGIS / PostgreSQL 16+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinel_grid
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_grid

# Security & Authentication (Change in Production!)
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Message Broker
REDIS_URL=redis://localhost:6379/0

# MediaMTX Video Relay
MEDIAMTX_HLS_BASE=http://localhost:8888
MEDIAMTX_WEBRTC_BASE=http://localhost:8889

# Storage
EVIDENCE_DIR=./evidence_storage

# AI & Detection Settings
YOLO_MODEL_PATH=ai/models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.50
OCR_CONFIDENCE_THRESHOLD=0.70
